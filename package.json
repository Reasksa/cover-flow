{
  "name": "reaksaio",
  "version": "0.1.0",
  "description": "Reaksaio - Windows desktop app for multi-platform social posting, scheduling, and automation",
  "main": "main.js",
  "author": "Reaksaio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "clean": "rimraf dist build"
  },
  "build": {
    "appId": "com.reaksaio.app",
    "productName": "Reaksaio",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "automation/**/*",
      "storage/**/*",
      "integrations/**/*",
      "app/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Reaksaio-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.2.1",
    "keytar": "^7.12.0",
    "selenium-webdriver": "^4.24.0",
    "googleapis": "^164.1.0"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.9.5",
    "rimraf": "^5.0.5"
  }
}